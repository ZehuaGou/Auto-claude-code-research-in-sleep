# Exa Search
EXA_API_KEY=

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# MiniMax Chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# LLM Chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_SERVER_NAME=llm-chat

# Gemini Review
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_REVIEW_SERVER_NAME=gemini-review
GEMINI_BIN=gemini
GEMINI_REVIEW_MODEL=
GEMINI_REVIEW_SYSTEM=
GEMINI_REVIEW_BACKEND=api
GEMINI_REVIEW_TIMEOUT_SEC=600
GEMINI_REVIEW_API_MODEL=gemini-2.5-flash
GEMINI_REVIEW_DEBUG_LOG=/tmp/gemini-review-mcp-debug.log

# Feishu Bridge
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
FEISHU_RECEIVE_ID_TYPE=user_id
BRIDGE_PORT=5000

# Claude Review
CLAUDE_REVIEW_SERVER_NAME=claude-review
CLAUDE_BIN=claude
CLAUDE_REVIEW_MODEL=
CLAUDE_REVIEW_SYSTEM=
CLAUDE_REVIEW_TOOLS=
CLAUDE_REVIEW_TIMEOUT_SEC=600
CLAUDE_REVIEW_DEBUG_LOG=/tmp/claude-review-mcp-debug.log

# ===== ARIS Research Reliability Additions =====

# LLM Chat: thinking/reasoning_effort/max_tokens (optional, for server.py)
# LLM_THINKING: enabled | disabled
# LLM_REASONING_EFFORT: low | medium | high | max
# LLM_MAX_TOKENS: max response tokens (default: 4096)
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=8192

# ===== Role-Based Model Routing =====
# These define which model each research role uses.
# Primary = "codex" means use Codex (fallback to LLM_FALLBACK_MODEL).
# Non-Codex roles use the specified LLM_MODEL directly.

# Literature search / paper metadata
LLM_LITERATURE_SCOUT_MODEL=deepseek-v4-flash
LLM_LITERATURE_SCOUT_THINKING=enabled
LLM_LITERATURE_SCOUT_REASONING_EFFORT=high

# Paper summarization (after paper-ingest)
LLM_PAPER_SUMMARIZER_MODEL=deepseek-v4-flash
LLM_PAPER_SUMMARIZER_THINKING=enabled
LLM_PAPER_SUMMARIZER_REASONING_EFFORT=high

# Idea generation
LLM_IDEA_GENERATOR_MODEL=deepseek-v4-pro
LLM_IDEA_GENERATOR_THINKING=enabled
LLM_IDEA_GENERATOR_REASONING_EFFORT=high

# Idea reviewer: Codex preferred
LLM_IDEA_REVIEWER_PRIMARY=codex
LLM_IDEA_REVIEWER_FALLBACK_MODEL=deepseek-v4-pro
LLM_IDEA_REVIEWER_FALLBACK_THINKING=enabled
LLM_IDEA_REVIEWER_FALLBACK_REASONING_EFFORT=max

# Novelty checker: Codex preferred
LLM_NOVELTY_CHECKER_PRIMARY=codex
LLM_NOVELTY_CHECKER_FALLBACK_MODEL=deepseek-v4-pro
LLM_NOVELTY_CHECKER_FALLBACK_THINKING=enabled
LLM_NOVELTY_CHECKER_FALLBACK_REASONING_EFFORT=max

# Research contract reviewer: Codex preferred
LLM_CONTRACT_REVIEWER_PRIMARY=codex
LLM_CONTRACT_REVIEWER_FALLBACK_MODEL=deepseek-v4-pro
LLM_CONTRACT_REVIEWER_FALLBACK_THINKING=enabled
LLM_CONTRACT_REVIEWER_FALLBACK_REASONING_EFFORT=max

# Baseline reproduction reviewer
LLM_BASELINE_REVIEWER_MODEL=deepseek-v4-pro
LLM_BASELINE_REVIEWER_THINKING=enabled
LLM_BASELINE_REVIEWER_REASONING_EFFORT=high

# Experiment code reviewer
LLM_EXPERIMENT_CODE_REVIEWER_MODEL=deepseek-v4-pro
LLM_EXPERIMENT_CODE_REVIEWER_THINKING=enabled
LLM_EXPERIMENT_CODE_REVIEWER_REASONING_EFFORT=high

# Experiment auditor: Codex preferred
LLM_EXPERIMENT_AUDITOR_PRIMARY=codex
LLM_EXPERIMENT_AUDITOR_FALLBACK_MODEL=deepseek-v4-pro
LLM_EXPERIMENT_AUDITOR_FALLBACK_THINKING=enabled
LLM_EXPERIMENT_AUDITOR_FALLBACK_REASONING_EFFORT=max

# Result judge: Codex preferred
LLM_RESULT_JUDGE_PRIMARY=codex
LLM_RESULT_JUDGE_FALLBACK_MODEL=deepseek-v4-pro
LLM_RESULT_JUDGE_FALLBACK_THINKING=enabled
LLM_RESULT_JUDGE_FALLBACK_REASONING_EFFORT=max

# Final paper auditor: Codex preferred
LLM_FINAL_AUDITOR_PRIMARY=codex
LLM_FINAL_AUDITOR_FALLBACK_MODEL=deepseek-v4-pro
LLM_FINAL_AUDITOR_FALLBACK_THINKING=enabled
LLM_FINAL_AUDITOR_FALLBACK_REASONING_EFFORT=max

# Log summarizer (lightweight)
LLM_LOG_SUMMARIZER_MODEL=deepseek-v4-flash
LLM_LOG_SUMMARIZER_THINKING=disabled

# Feishu notification (optional)
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Proxy (for arXiv, Semantic Scholar, etc.)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
# http_proxy=http://127.0.0.1:7890

# ===== Global Codex Gate Routing =====
# Controls critical judgment gates:
# evidence_integrity_auditor, idea_shortlist_auditor, idea_reviewer,
# novelty_checker, adversarial_reviewer, final_selector,
# experiment_auditor, result_judge, final_paper_auditor, contract_reviewer
#
# codex_required  = require Codex; fail if unavailable
# codex_preferred = try Codex first; fallback to DeepSeek V4 Pro with warning
# deepseek_only   = skip Codex explicitly; use DeepSeek V4 Pro and mark codex_used=false
ARIS_CODEX_GATE_MODE=codex_preferred

ARIS_CODEX_FALLBACK_MODEL=deepseek-v4-pro
ARIS_CODEX_FALLBACK_THINKING=enabled
ARIS_CODEX_FALLBACK_REASONING_EFFORT=max

# Per-role override examples (overrides ARIS_CODEX_GATE_MODE for a specific role):
# LLM_FINAL_SELECTOR_PRIMARY=codex
# LLM_FINAL_SELECTOR_PRIMARY=deepseek
# LLM_NOVELTY_CHECKER_PRIMARY=deepseek
#
# If LLM_<ROLE>_PRIMARY is set to "codex", the role follows codex_required behavior.
# If set to "deepseek" or a model name, it overrides the global mode for that role.
# If unset, the role falls back to ARIS_CODEX_GATE_MODE.

# ===== Agentic Idea Discovery (isolated job runner) =====
LLM_GAP_EXTRACTOR_MODEL=deepseek-v4-pro
LLM_GAP_EXTRACTOR_THINKING=enabled
LLM_GAP_EXTRACTOR_REASONING_EFFORT=high

LLM_IDEA_DEDUPLICATOR_MODEL=deepseek-v4-pro
LLM_IDEA_DEDUPLICATOR_THINKING=enabled
LLM_IDEA_DEDUPLICATOR_REASONING_EFFORT=high

LLM_ADVERSARIAL_REVIEWER_PRIMARY=codex
LLM_ADVERSARIAL_REVIEWER_FALLBACK_MODEL=deepseek-v4-pro
LLM_ADVERSARIAL_REVIEWER_FALLBACK_THINKING=enabled
LLM_ADVERSARIAL_REVIEWER_FALLBACK_REASONING_EFFORT=max

# Evidence integrity auditor: Codex preferred
LLM_EVIDENCE_AUDITOR_PRIMARY=codex
LLM_EVIDENCE_AUDITOR_FALLBACK_MODEL=deepseek-v4-pro
LLM_EVIDENCE_AUDITOR_FALLBACK_THINKING=enabled
LLM_EVIDENCE_AUDITOR_FALLBACK_REASONING_EFFORT=max

# Idea shortlist auditor / weak idea killer: Codex preferred
LLM_IDEA_SHORTLIST_AUDITOR_PRIMARY=codex
LLM_IDEA_SHORTLIST_AUDITOR_FALLBACK_MODEL=deepseek-v4-pro
LLM_IDEA_SHORTLIST_AUDITOR_FALLBACK_THINKING=enabled
LLM_IDEA_SHORTLIST_AUDITOR_FALLBACK_REASONING_EFFORT=max

# Final selector: Codex preferred
LLM_FINAL_SELECTOR_PRIMARY=codex
LLM_FINAL_SELECTOR_FALLBACK_MODEL=deepseek-v4-pro
LLM_FINAL_SELECTOR_FALLBACK_THINKING=enabled
LLM_FINAL_SELECTOR_FALLBACK_REASONING_EFFORT=max

ISOLATED_JOB_RUNNER_DEFAULT_BACKEND=api
ISOLATED_JOB_RUNNER_TIMEOUT_SEC=900
ISOLATED_JOB_RUNNER_MAX_TURNS=8
ISOLATED_JOB_RUNNER_USE_BARE=true

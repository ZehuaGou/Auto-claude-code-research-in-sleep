# ============================================================
# ARIS Env Template — Role-Based Model Routing
# ============================================================
# Copy this file to .env and fill in your API keys.
# All roles use MODEL_ aliases + ROLE_ assignments.
# Old LLM_* variables are still read for backward compatibility.
# ============================================================

# ===== 1. Backend Configuration =====
# API keys — only required for OpenAI-compatible API providers.
# Codex MCP does NOT require an API key here.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 2. Codex MCP Backend =====
# Codex is an MCP server, not an API provider.
# No API key needed — Codex auth comes from the Claude Code app.
# Use Codex's current default. Change to gpt-5.5 when available.
CODEX_ENABLED=true
CODEX_MCP_SERVER=codex
CODEX_DEFAULT_MODEL=auto

# ===== 3. Model Aliases =====
# Syntax: MODEL_<ALIAS>=<provider>:<model>
# provider: deepseek | kimi | minimax | openai | codex
# Model aliases are referenced by ROLE_<ROLE>=<ALIAS>

MODEL_DS_FLASH=deepseek:deepseek-v4-flash
MODEL_DS_PRO_HIGH=deepseek:deepseek-v4-pro
MODEL_DS_PRO_MAX=deepseek:deepseek-v4-pro
MODEL_CODEX=codex:${CODEX_DEFAULT_MODEL}
MODEL_KIMI_LONG=kimi:moonshot-v1-32k
MODEL_MINIMAX=minimax:MiniMax-M2.7

# ===== 4. Model Parameters (per alias) =====
# MODEL_<ALIAS>_THINKING: enabled | disabled
# MODEL_<ALIAS>_EFFORT: low | medium | high | max

MODEL_DS_FLASH_THINKING=disabled
MODEL_DS_FLASH_EFFORT=low

MODEL_DS_PRO_HIGH_THINKING=enabled
MODEL_DS_PRO_HIGH_EFFORT=high

MODEL_DS_PRO_MAX_THINKING=enabled
MODEL_DS_PRO_MAX_EFFORT=max

MODEL_KIMI_LONG_THINKING=enabled
MODEL_KIMI_LONG_EFFORT=medium

MODEL_MINIMAX_THINKING=enabled
MODEL_MINIMAX_EFFORT=medium

# CODEX_EFFORT is passed to Codex reasoning (xlow | low | medium | high | xhigh | max)
MODEL_CODEX_EFFORT=xhigh

# ===== 5. Role Assignments =====
# Syntax: ROLE_<ROLE>=<MODEL_ALIAS>
#
# ⚠️  ROLE_<ROLE> only DECLARES the expected routing — it does NOT confirm a real
# model was called. Trust requires a ledger entry with implementation_source=
# routed_internal_model and verification_status=verified_routed_call.
# All ROLE_* execution must go through tools/trusted_role_runner.py.
# Codex calls require codex_thread_id in the ledger entry.
# External agents cannot masquerade as routed_internal_model (external_agent_direct).
# Silent fallback is forbidden — fallback must have explicit fallback_reason.
# Dry-run / mock cannot be used as real research evidence.
#
# All available roles:
#   literature_scout, paper_summarizer, gap_extractor
#   idea_generator, idea_deduplicator
#   idea_reviewer, novelty_checker, adversarial_reviewer
#   final_selector, contract_reviewer
#   experiment_implementer, experiment_code_reviewer, experiment_auditor
#   result_judge
#   paper_writer, claims_drafter, final_auditor
#   log_summarizer, baseline_reviewer

ROLE_LITERATURE_SCOUT=DS_FLASH
ROLE_PAPER_SUMMARIZER=DS_FLASH
ROLE_GAP_EXTRACTOR=DS_PRO_HIGH
ROLE_IDEA_GENERATOR=DS_PRO_HIGH
ROLE_IDEA_DEDUPLICATOR=DS_PRO_HIGH
ROLE_IDEA_REVIEWER=CODEX
ROLE_NOVELTY_CHECKER=CODEX
ROLE_ADVERSARIAL_REVIEWER=CODEX
ROLE_FINAL_SELECTOR=CODEX
ROLE_CONTRACT_REVIEWER=CODEX
ROLE_EXPERIMENT_IMPLEMENTER=DS_PRO_HIGH
ROLE_EXPERIMENT_CODE_REVIEWER=CODEX
ROLE_EXPERIMENT_AUDITOR=CODEX
ROLE_RESULT_JUDGE=CODEX
ROLE_PAPER_WRITER=DS_PRO_HIGH
ROLE_CLAIMS_DRAFTER=DS_PRO_HIGH
ROLE_FINAL_AUDITOR=CODEX
ROLE_LOG_SUMMARIZER=DS_FLASH
ROLE_BASELINE_REVIEWER=DS_PRO_HIGH

# ===== 6. Optional Services =====

# Exa Search
EXA_API_KEY=

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# Feishu Bridge
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
FEISHU_RECEIVE_ID_TYPE=user_id
BRIDGE_PORT=5000

# Feishu Webhook (alternative to Bridge mode)
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Proxy (for arXiv, Semantic Scholar, etc.)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ===== 7. Advanced Compatibility (Legacy LLM_* vars) =====
# These are read as fallbacks if the new ROLE_/MODEL_ system is not configured.
# Uncomment and set only if you have existing .env values.

# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
# LLM_FALLBACK_MODEL=deepseek-v4-flash
# LLM_THINKING=enabled
# LLM_REASONING_EFFORT=high
# LLM_MAX_TOKENS=8192

# ISOLATED_JOB_RUNNER_DEFAULT_BACKEND=api
# ISOLATED_JOB_RUNNER_TIMEOUT_SEC=900
# ISOLATED_JOB_RUNNER_MAX_TURNS=8
